    "## 5. SCHEMA REGISTRY E GOLDEN TESTS\n",
    "\n",
    "Validação de schema com testes golden para garantir reprodutibilidade."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Schema esperado para PNADc Plataformas 2022\n",
    "SCHEMA_PNADC_PLATFORM_2022 = {\n",
    'required_columns': ['UF', 'peso', 'estrato', 'V1008', 'S140093', 'rendimento_real_habitual'],\n",
    'dtypes': {\n",
    'UF': 'int32',\n",
    'peso': 'float64',\n",
    'estrato': 'object',\n",
    'V1008': 'int32',\n",
    'S140093': 'category',\n",
    'rendimento_real_habitual': 'float64'\n",
    },\n",
    'ranges': {\n",
    'UF': (11, 53),\n",
    'peso': (0, None),\n",
    'V1008': (14, 100)\n",
    }\n",
    "}\n",
    "\n",
    "def validate_schema(df, schema, source_name):\n",
    "    \"\"\"Valida DataFrame contra schema registry.\"\"\"\n",
    "    errors = []\n",
    "    \n",
    "    # Check required columns\n",
    "    missing_cols = set(schema['required_columns']) - set(df.columns)\n",
    "    if missing_cols:\n",
    "        errors.append(f\"Colunas faltando: {missing_cols}\")\n",
    "    \n",
    "    # Check ranges\n",
    "    for col, (min_val, max_val) in schema.get('ranges', {}).items():\n",
    "        if col in df.columns:\n",
    "            actual_min = df[col].min()\n",
    "            actual_max = df[col].max()\n",
    "            if min_val is not None and actual_min < min_val:\n",
    "                errors.append(f\"{col}: min {actual_min} < {min_val}\")\n",
    "            if max_val is not None and actual_max > max_val:\n",
    "                errors.append(f\"{col}: max {actual_max} > {max_val}\")\n",
    "    \n",
    "    if errors:\n",
    "        print(f\"❌ {source_name}: {len(errors)} erros de schema\")\n",
    "        for err in errors:\n",
    "            print(f\"   - {err}\")\n",
    "        return False\n",
    "    else:\n",
    "        print(f\"✅ {source_name}: Schema validado com sucesso\")\n",
    "        return True\n",
    "\n",
    "# Salvar schema registry\n",
    "schema_path = REPORTS_DIR / 'schema_registry.json'\n",
    "with open(schema_path, 'w', encoding='utf-8') as f:\n",
    "    json.dump({'PNADc_PLATFORM_2022': SCHEMA_PNADC_PLATFORM_2022}, f, indent=2)\n",
    "\n",
    "print(f\"✅ Schema registry salvo em: {schema_path}\")"
   ]
